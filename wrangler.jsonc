{
  // Cloudflare Workers config for snepking.com.
  // Workers Builds runs `npx wrangler deploy` on every push to main.
  "name": "snepking",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/img/*"]
  },
  // The "snepking-site" KV namespace (created in the dashboard): saved gallery data and uploaded images.
  "kv_namespaces": [{ "binding": "SITE", "id": "bdc69c67d1c24f1b8d2c8e856ddf5ad5" }],
  "observability": { "enabled": true }
}
